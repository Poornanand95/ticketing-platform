# Monorepo: Node.js / TypeScript / Next.js

# Dependencies
node_modules/
.pnpm-store/
.pnp.*

# Yarn Berry (ignore caches, keep config/plugins/releases committed if present)
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/

# Build outputs
dist/
build/
out/
.next/
.turbo/
.nx/

# Common tooling caches (any package)
**/.next/
**/.turbo/
**/.nx/
**/.swc/
**/.parcel-cache/
**/.cache/
**/.webpack/
**/.vite/
**/.rollup.cache/

# Hosting / deploy tooling
.vercel/
.netlify/
**/.vercel/
**/.netlify/

# TypeScript / Next.js generated
*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# Logs
logs/
**/logs/
*.log
lerna-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Test / coverage
coverage/
.nyc_output/
**/coverage/
**/.nyc_output/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Env files (keep examples/templates committed)
.env
.env.*
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template
!**/.env.*.example
!**/.env.*.sample
!**/.env.*.template

# Direnv / dotenv helpers
.envrc
.direnv/

# Secrets (avoid committing private keys)
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local DB / sqlite (if used)
*.sqlite
*.sqlite3

# Temp files
tmp/
.tmp/
.temp/
**/tmp/
**/.tmp/
**/.temp/
*.tmp

# OS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.idea/
.vscode/
*.iml
*.swp
*.swo
*.swn
*~

# Optional: local tooling artifacts
.eslintcache
**/.eslintcache
.npmrc

# Biome
.biome/
**/.biome/


