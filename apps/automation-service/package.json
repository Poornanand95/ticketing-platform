{
  "name": "@ticketing/automation-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "check-types": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "seed-automations": "tsx src/scripts/seed-automations.ts"
  },
  "dependencies": {
    "@ticketing/config": "workspace:*",
