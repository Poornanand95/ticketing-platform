    "@ticketing/logger": "workspace:*",
    "@ticketing/types": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "redis": "^4.7.0",
    "nanoid": "^5.0.7",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.17",
    "tsx": "^4.7.1",
    "typescript": "5.9.2"
  }
